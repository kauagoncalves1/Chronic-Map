# Opcional. Deixe VAZIO/ausente: o front usa o proxy /api (sem CORS) para a API.
# Defina so se quiser chamar a API direto, por exemplo: http://localhost:8000
# NEXT_PUBLIC_API_URL=

# Para onde o proxy /api encaminha. Local: http://localhost:8000 | Docker: http://api:8000
# API_PROXY_TARGET=http://localhost:8000
